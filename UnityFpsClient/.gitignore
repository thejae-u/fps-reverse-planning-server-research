# ==========================================
# Unity Standard Gitignore
# ==========================================

# 1. Temporary and cache directories generated by Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Build]/
/[Builds]/
/[Logs]/
/[UserSettings]/
/[MemoryCaptures]/

# 2. Asset Store tools
/Assets/AssetStoreTools*

# 3. IDE generated project and workspace files
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.tmp
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svclog
/*.userosscache
.vs/
.idea/
.vscode/

# 4. Builds directory
/[Bb]uild/
/[Bb]uilds/

# 5. Crash reports and sysinfo
sysinfo.txt
CrashReport*

# 6. OS files
.DS_Store
